# Skopiuj do .env.local i uzupełnij. Plik .env.local jest ignorowany przez git.

# --- AI (Anthropic Claude API): https://console.anthropic.com ---
ANTHROPIC_API_KEY=

# Model i głębokość myślenia (low | medium | high). Zmieniamy bez dotykania kodu.
AI_MODEL=claude-haiku-4-5
AI_EFFORT_SWATKA=medium

# --- Baza danych (Supabase albo lokalny Postgres) ---
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo: hasło do panelu Centrala (rola ROPS) i sekret podpisu cookie ---
DEMO_ADMIN_PASSWORD=
SESSION_SECRET=
