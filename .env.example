# Skopiuj do .env.local i uzupełnij. Plik .env.local jest ignorowany przez git.

# --- AI (DeepSeek API): https://platform.deepseek.com ---
DEEPSEEK_API_KEY=

# Model DeepSeek. Tryb myślenia jest wyłączony dla szybszych odpowiedzi JSON.
AI_MODEL=deepseek-flash

# --- Baza danych (Supabase albo lokalny Postgres) ---
# Na Vercelu DATABASE_URL jest też potrzebne podczas builda do automatycznych migracji.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo: hasło do panelu Centrala (rola ROPS) i sekret podpisu cookie ---
DEMO_ADMIN_PASSWORD=
SESSION_SECRET=

# Dostęp ekspercki: ustaw osobne hasło. Nie jest wyświetlane w interfejsie.
DEMO_EKSPERT_PASSWORD=
# Wyłącznie izolowane publiczne demo z syntetycznymi danymi: SPLOT_PUBLIC_DEMO=1
